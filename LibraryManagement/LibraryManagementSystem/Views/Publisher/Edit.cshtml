@model LibraryManagementSystem.Models.Publisher

<h1>Edit Publisher</h1>
<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <div>
        <label for="Name">Name:</label>
        <input type="text" asp-for="Name" required />
    </div>
    <div>
        <label for="Parent">Parent:</label>
        <input type="number" asp-for="Parent" />
    </div>
    <div>
        <label for="Status">Status:</label>
        <ul class="status-selector">
            <li>
                <input type="radio" id="status-active" name="Status" value="1" @(Model.Status == 1 ? "checked" : "") />
                <label for="status-active">Đang hoạt động</label>
            </li>
            <li>
                <input type="radio" id="status-inactive" name="Status" value="0" @(Model.Status == 0 ? "checked" : "") />
                <label for="status-inactive">Ngừng hoạt động</label>
            </li>
            <li>
                <input type="radio" id="status-unknown" name="Status" value="-1" @(Model.Status == -1 ? "checked" : "") />
                <label for="status-unknown">Không rõ</label>
            </li>
        </ul>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a href="@Url.Action("Index", "Publisher")" class="btn btn-secondary">Cancel</a>
</form>
