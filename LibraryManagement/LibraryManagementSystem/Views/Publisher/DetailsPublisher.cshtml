@model LibraryManagementSystem.Models.Publisher
<link rel="stylesheet" href="~/features/Publisher/Index/publisher.css" />

<div class="container">
    <h2>Chi Tiết Nhà Xuất Bản</h2>
    <p><strong>Tên:</strong> @Model.Name</p>
    <p><strong>Cha:</strong> @Model.ParentNavigation?.Name</p>
    <p><strong>Trạng thái:</strong> @(Model.Status == 1 ? "Active" : "Inactive")</p>
    <a asp-action="Index">Quay lại</a>
</div>
