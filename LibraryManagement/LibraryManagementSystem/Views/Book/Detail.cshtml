@model LibraryManagementSystem.Models.Book

@{
    ViewData["Title"] = "Detail";
    var countryNames = new Dictionary<string, string>
    {
        { "00", "Không rõ" },
        { "VN", "Tiếng Việt" },
        { "EN", "Anh" },
        { "US", "Hoa Kỳ" },
        { "FR", "Pháp" },
        { "JP", "Nhật Bản" },
        { "KR", "Hàn Quốc" },
        { "CN", "Trung Quốc" },
        { "DE", "Đức" },
        { "AU", "Úc" },
        { "IT", "Ý" },
        { "ES", "Tây Ban Nha" },
        { "CA", "Canada" },
        { "IN", "Ấn Độ" },
        { "BR", "Brazil" }
    };
}

<link rel="stylesheet" href="~/features/Book/Detail/book.css?v=@DateTime.Now.Ticks" />

<div class="book-detail">
    <div class="book-detail-left">
        <div class="book-detail-left-img">
            <div class="large-image-container">
                <img id="largeImage"
                     src="@(Model.BookImgs.FirstOrDefault()?.Image != null ? "data:image/jpeg;base64," + Convert.ToBase64String(Model.BookImgs.FirstOrDefault().Image) : "/path/to/placeholder.jpg")"
                     alt="Book Image"
                     class="large-image" />
            </div>
        </div>
        <div class="book-images-gallery">
            @foreach (var img in Model.BookImgs)
            {
                <div class="book-image">
                    <img src="@(img.Image != null ? "data:image/jpeg;base64," + Convert.ToBase64String(img.Image) : "/path/to/placeholder.jpg")"
                         alt="Book Image"
                         class="small-image"
                         onclick="changeLargeImage('@(img.Image != null ? Convert.ToBase64String(img.Image) : "")')" />
                </div>
            }
        </div>
    </div>
    <div class="book-detail-right">
        <div class="book-title-authors">
            <h1>@Html.DisplayFor(model => model.Name)</h1>
            <p class="authors">
                <span><b>Tác giả: </b></span>
                @if (Model.Authors.Any())
                {
                    @if (User != null && User.IsInRole("ADMINISTRATOR"))
                    {
                        var isFirst = true;
                        foreach (var author in Model.Authors)
                        {
                            if (!isFirst)
                            {
                                @:<span>, </span>
                            }
                            <a asp-action="Detail" asp-controller="Author" asp-route-id="@author.Id">@author.Name</a>
                            isFirst = false;
                        }
                    }
                    else
                    {
                        var isFirst = true;
                        foreach (var author in Model.Authors)
                        {
                            if (!isFirst)
                            {
                                @:<span>, </span>
                            }
                            <a>@author.Name</a>
                            isFirst = false;
                        }
                    }
                }
                else
                {
                    <span>Chưa có tác giả</span>
                }
            </p>
        </div>
        <div class="book-description">
            <p class="info-title"><b>Mô tả:</b></p>
            <p>@Html.DisplayFor(model => model.Description)</p>
        </div>
        <div class="book-basic-info">
            <div>
                <p class="info-title">Ngày phát hành:</p>

                <p>@Html.DisplayFor(model => model.PublishYear)</p>
            </div>
            <div>
                <p class="info-title">Nhà phát hành:</p>
                @if (User != null && User.IsInRole("ADMINISTRATOR"))
                {
                    <a asp-action="Detail" asp-controller="Publisher" asp-route-id="@Model.PublisherNavigation.Id">@Html.DisplayFor(model => model.PublisherNavigation.Name)</a>
                }
                else
                {
                    <p>@Html.DisplayFor(model => model.PublisherNavigation.Name)</p>
                }
            </div>
            <div>
                <p class="info-title">Ngôn ngữ:</p>
                <p>@(countryNames.ContainsKey(Model.Language) ? countryNames[Model.Language] : "Không rõ")</p>
            </div>
            <div>
                <p class="info-title">Số trang:</p>
                <p>@Html.DisplayFor(model => model.PageNumber)</p>
            </div>
        </div>

        <div class="book-categories">
            <p>
                <b>Thể loại:</b>
                @if (User != null && User.IsInRole("ADMINISTRATOR"))
                {
                    @if (Model.Categories.Any())
                    {
                        var isFirstCateg = true;
                        foreach (var categ in Model.Categories)
                        {
                            if (!isFirstCateg)
                            {
                                @:<span>, </span>
                            }
                            <a asp-action="Detail" asp-controller="Category" asp-route-id="@categ.Id">@categ.Name</a>
                            isFirstCateg = false;
                        }
                    }
                    else
                    {
                        <span>Chưa có thể loại</span>
                    }
                }
                else
                {
                    @if (Model.Categories.Any())
                    {
                        var isFirstCateg = true;
                        foreach (var categ in Model.Categories)
                        {
                            if (!isFirstCateg)
                            {
                                @:<span>, </span>
                            }
                            <a>@categ.Name</a>
                            isFirstCateg = false;
                        }
                    }
                    else
                    {
                        <span>Chưa có thể loại</span>
                    }
                }
            </p>
        </div>
        <div class="book-additional-info">
            <div>
                <p><b>Thuộc series:</b> @Html.DisplayFor(model => model.SeriesNavigation.Name)</p>
            </div>
            <div>
                <p><b>Mã ISBN:</b> @Html.DisplayFor(model => model.Isbn)</p>
            </div>
            <div>
                <p><b>Phiên bản:</b> @Html.DisplayFor(model => model.Version)</p>
            </div>
            @if (User != null && User.IsInRole("ADMINISTRATOR"))
            {
                <div>
                    <p>
                        <b>Nhà cung cấp:</b>
                        @if (Model.VendorNavigation != null && Model.VendorNavigation.Name != null)
                        {
                            <a asp-action="Detail" asp-controller="Vendor" asp-route-id="@Model.PublisherNavigation.Id">@Model.VendorNavigation.Name</a>
                        }
                        else
                        {
                            <span>Chưa có nhà cung cấp</span>
                        }
                    </p>
                </div>
            }
        </div>


        <!-- Update Button for Admin -->
        @if (User != null && User.IsInRole("ADMINISTRATOR"))
        {
            <a asp-action="Update" asp-controller="adminbook" asp-route-id="@Model.Id" class="btn btn-primary">Cập nhật</a>
        }
    </div>
</div>

<script>
    // Function to change the large image when a small image is clicked
    function changeLargeImage(imageBase64) {
        var largeImage = document.getElementById("largeImage");
        if (imageBase64) {
            largeImage.src = "data:image/jpeg;base64," + imageBase64;
        } else {
            largeImage.src = "/path/to/placeholder.jpg"; // Fallback if the clicked image is null
        }
    }
</script>
