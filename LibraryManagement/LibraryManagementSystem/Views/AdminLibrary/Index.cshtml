@using LibraryManagementSystem.DTO.LibraryDTO
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
@model IEnumerable<LibraryDto>
@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/2.1.8/css/dataTables.dataTables.css" />
    <script src="https://cdn.datatables.net/2.1.8/js/dataTables.js"></script>

}
<div class="container">
    <div class="row col-md-12">
        <h1>Danh sách chi nhánh</h1>
    </div>
    <a asp-action="Create" asp-controller="AdminLibrary" class="btn btn-success">Thêm chi nhánh</a>
    <table class="table table-outline" id="data-table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Tên</th>
                <th>Địa chỉ</th>
                <th>Hoạt động</th>
                <th>Tình trạng</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach(var lib in Model)
            {
                <tr>
                    <td>@lib.Id</td>
                    <td>@lib.Name</td>
                    <td>@lib.Address</td>
                    <td>@lib.OpenFrom - @lib.OpenTo</td>
                    <td>@lib.Status</td>
                    <td>
                        <div class="flex action-box" id="action-box-@lib.Id" data-id="@lib.Id">
                            <a asp-action="Details" asp-controller="AdminLibrary" asp-route-id="@lib.Id" class="btn btn-outline-primary btn-details" data-id="@lib.Id">Details</a>
                            <a asp-action="Update" asp-controller="AdminLibrary" asp-route-id="@lib.Id" class="btn btn-outline-success btn-update" data-id="@lib.Id">Update</a>
                            <a class="btn btn-danger btn-delete" data-id="@lib.Id">Delte</a>
                        </div>
                        <div class="flex delete-confirm-box" id="delete-confirm-box-@lib.Id" data-id="@lib.Id">
                            <a asp-action="Delete" asp-controller="AdminLibrary" asp-route-id="@lib.Id" class="btn btn-outline-success btn-confirm" data-id="@lib.Id">Confirm</a>
                            <a class="btn btn-outline-danger btn-cancel" data-id="@lib.Id">Cancel</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script src="~/features/Admin/Library/scripts.js"></script>
}